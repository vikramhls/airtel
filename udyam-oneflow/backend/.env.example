# Copy to backend/.env and fill in. Never commit the real file.
LLM_PROVIDER=gemini,openrouter      # order to try; "none" = scripted advisor only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free
LLM_TIMEOUT_S=8
OCR_FALLBACK_LLM=0
REFERENCE_DATE=2026-07-15
